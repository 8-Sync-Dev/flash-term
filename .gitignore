current-bg.lua
current-opacity.lua
current-style.lua
current-gpu.lua

# Tool-generated / local-only
.serena/

# ── GSD runtime (machine-specific, never commit) ──────────────────────────
.gsd/activity/
.gsd/journal/
.gsd/runtime/
.gsd/worktrees/
.gsd/gsd.db
.gsd/gsd.db-journal
.gsd/gsd.db-wal
.gsd/gsd.db-shm
.gsd/metrics.json
.gsd/state-manifest.json
.gsd.migrating/

# ── bg-shell runtime state ────────────────────────────────────────────────
.bg-shell/

# ── OS / editor junk ──────────────────────────────────────────────────────
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/
*.code-workspace
.env
.env.*
!.env.example

# ── Language / build output ───────────────────────────────────────────────
node_modules/
.next/
dist/
build/
__pycache__/
*.pyc
.venv/
venv/
target/
vendor/
