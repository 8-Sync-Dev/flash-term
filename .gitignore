# User-specific state
.state/

# Wallpaper images (large, user-specific)
bg/

# Bundled fonts (reinstallable via scoop/nerd-fonts)
fonts/

# Dynamic config files (generated by 8sync commands)
current-bg.lua
current-opacity.lua
current-style.lua
current-gpu.lua

# Tool-generated / local-only
.serena/

# ── GSD runtime (machine-specific, never commit) ──────────────────────────
.gsd/activity/
.gsd/journal/
.gsd/runtime/
.gsd/worktrees/
.gsd/gsd.db
.gsd/gsd.db-journal
.gsd/gsd.db-wal
.gsd/gsd.db-shm
.gsd/metrics.json
.gsd/state-manifest.json
.gsd/notifications.jsonl
.gsd/last-snapshot.md
.gsd/CODEBASE.md
.gsd/exec/
.gsd.migrating/

# ── bg-shell runtime state ────────────────────────────────────────────────
.bg-shell/

# ── Forge init artefacts (generated by `8sync forge init` / `migrate`) ────
# These belong to *user projects* where init is run, never to the wezterm repo
# itself. If they appear at wezterm repo root, it means init was accidentally
# run here -- do not commit.
.forge/
AGENTS.md.bak
AGENTS.md.bak-*
CLAUDE.md.bak
CLAUDE.md.bak-*

# ── OS / editor junk ──────────────────────────────────────────────────────
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/
*.code-workspace
.env
.env.*
!.env.example

# ── Language / build output ───────────────────────────────────────────────
node_modules/
.next/
dist/
build/
__pycache__/
*.pyc
.venv/
venv/
target/
vendor/
*.log

# ── Test projects for local gsd runtime (separate sandboxes) ────────────
test/
coverage/
.cache/
tmp/

# ── GSD baseline (auto-generated) ──
.DS_Store
